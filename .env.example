# ───────── Configuración general ─────────
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# En producción (con HTTPS):
# DEBUG=False
# ALLOWED_HOSTS=tickets.tudominio.com,tu-app.up.railway.app
# SITE_URL=https://tickets.tudominio.com
# CSRF_TRUSTED_ORIGINS=https://tickets.tudominio.com,https://tu-app.up.railway.app

# ───────── Base de datos ─────────
# En desarrollo se usa SQLite si dejas DATABASE_URL vacío.
# En Railway/Render/Heroku la variable se genera automáticamente al añadir PostgreSQL.
DATABASE_URL=

# ───────── Correo electrónico ─────────
# Para usar Gmail con app password (recomendado para empezar):
#   1. Activa verificación en dos pasos en tu cuenta de Google
#   2. Crea una "app password" en https://myaccount.google.com/apppasswords
#   3. Usa ese password aquí (no tu contraseña normal)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
DEFAULT_FROM_EMAIL=Tickets Hoteles <tucorreo@gmail.com>

# Lista de correos (separados por coma) que reciben aviso cuando entra un ticket
NOTIFICATION_EMAILS=tucorreo@gmail.com,otro.tecnico@hoteles.com

# Alternativas de proveedores SMTP:
# Brevo (gratis 300/día):
#   EMAIL_HOST=smtp-relay.brevo.com  EMAIL_PORT=587
# Mailgun:
#   EMAIL_HOST=smtp.mailgun.org      EMAIL_PORT=587
# Outlook/Office365:
#   EMAIL_HOST=smtp.office365.com    EMAIL_PORT=587
